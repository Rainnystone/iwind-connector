{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "iwind-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "DEPLOYMENT_STAGE": "local",
    "KEY_POOL_LAYOUT_ID": "ring-primary-v1"
  },
  "secrets": {
    "required": [
      "WIND_API_KEY_01",
      "WIND_API_KEY_02",
      "WIND_API_KEY_03",
      "ADMIN_TOKEN",
      "COOKIE_ENCRYPTION_KEY",
      "ACCESS_CLIENT_ID",
      "ACCESS_CLIENT_SECRET",
      "ACCESS_AUTHORIZATION_URL",
      "ACCESS_TOKEN_URL",
      "ACCESS_JWKS_URL",
      "ACCESS_ISSUER",
      "ACCESS_AUDIENCE",
      "ALLOWED_USER_EMAIL"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KEY_POOL",
        "class_name": "KeyPool"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KeyPool"]
    }
  ]
}
